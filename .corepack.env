# corepack 이 프로젝트 루트에서 자동으로 읽는 파일(COREPACK_ 접두사만 반영된다).
# 빌드뿐 아니라 런타임에도 적용돼서, Render 대시보드를 건드리지 않고 corepack 동작을 고칠 수 있다.

# spec 이 없을 때 package.json 에 "packageManager" 를 몰래 써 넣는 동작(auto-pin)을 끈다.
# 이게 켜져 있으면 빌드 중에 필드가 되살아나고, 그 결과 런타임 `yarn start` 가 죽는다:
#   This project is configured to use pnpm because .../package.json has a "packageManager" field
COREPACK_ENABLE_AUTO_PIN=0

# 프로젝트 spec 과 다른 매니저를 불러도 예외를 던지지 말고 그냥 실행한다.
# Render 의 Start Command 기본값이 `yarn start` 라서 필요하다(이 저장소는 pnpm 이다).
COREPACK_ENABLE_STRICT=0
