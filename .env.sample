# docker compose 용 루트 환경변수 (.env 로 복사)
# 앱별 설정은 apps/api/.env.sample, apps/web/.env.sample 참고.

# 호스트에 노출할 포트
API_PORT=8000
WEB_PORT=5173
WEB_PROD_PORT=8080

# 파일 변경 감시 방식
# 레포가 Windows 파일시스템(C:\...)에 있고 도커가 WSL 에서 돌면 inotify 이벤트가
# 컨테이너까지 오지 않는다. 그럴 때만 true 로 켠다(폴링이라 CPU 를 조금 더 쓴다).
WATCH_POLLING=false

# 백엔드
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# (추후) DB — 지금은 인메모리라 사용하지 않음
# POSTGRES_USER=bulletbrak
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=bulletbrak
# DATABASE_URL=postgresql+asyncpg://bulletbrak:change-me@db:5432/bulletbrak
