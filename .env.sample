# 루트 환경변수 (.env 로 복사)
#
# 이 파일은 **배포 스택(docker-compose.yml)** 이 읽는 값이 중심이다.
# 도커는 배포 전용이고, 로컬 개발은 도커 없이 `make dev` 로 한다.
# 앱별 설정은 apps/api/.env.sample, apps/web/.env.sample 참고.

# ── 배포 스택 (docker compose / Dokploy / Coolify) ────────────────────
# 호스트에 노출할 유일한 포트. nginx 컨테이너가 여기서 정적 번들 + /api + /ws 를 다 받는다.
WEB_PROD_PORT=8080

# api 가 허용할 프론트 오리진 (쉼표 구분, 끝에 / 붙이지 말 것).
# nginx 를 거쳐 동일 오리진으로 들어오므로 보통 진입점 URL 하나면 된다.
CORS_ORIGINS=http://localhost:8080

# Postgres. 비밀번호는 기본값이 없다 — 없으면 compose 가 기동을 거부한다.
# Dokploy / Coolify 를 쓴다면 이 값들을 대시보드의 환경변수로 넣는다.
POSTGRES_USER=bulletbrak
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bulletbrak

# ── 로컬 개발 (make dev) ──────────────────────────────────────────────
# 아래는 도커가 아니라 vite dev server / uvicorn 이 직접 읽는다.
#
# vite dev 서버 포트 (apps/web/vite.config.ts, 기본 5173)
# WEB_PORT=5173
#
# 계정 기능을 로컬에서 확인하고 싶을 때만 아무 Postgres 나 가리킨다.
# **비워 두면 인메모리 모드** — 게임은 그대로 되고 계정/코인 영속화만 꺼진다.
# DATABASE_URL=postgresql+asyncpg://bulletbrak:change-me@localhost:5432/bulletbrak
