# 백엔드 설정 (.env 로 복사해서 사용)
APP_NAME=bullet-brak
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 프론트 오리진 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 방/매치 튜닝
MAX_ROOMS=200
ROOM_IDLE_TIMEOUT_SEC=300

# (추후) DB — 지금은 인메모리라 사용하지 않음
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bulletbrak
