# 백엔드 설정 (.env 로 복사해서 사용)
#
# 이 값들은 `make dev` (로컬 uvicorn) 기준이다. 배포 스택(docker-compose.yml)에서는
# DEBUG / CORS_ORIGINS / DATABASE_URL / DB_AUTO_MIGRATE 를 compose 가 직접 주입하고,
# 이 .env 는 이미지에 들어가지 않는다(.dockerignore).
APP_NAME=bullet-brak
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 프론트 오리진 (쉼표 구분, 끝에 / 붙이지 말 것)
# 로컬 개발은 vite dev 서버(5173)가 /api, /ws 를 프록시한다.
# 배포에서는 nginx 진입점 URL 하나면 된다(예: https://bulletbrak.example.com).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 방/매치 튜닝
MAX_ROOMS=200
ROOM_IDLE_TIMEOUT_SEC=300

# ── DB ────────────────────────────────────────────────────────────────
# **비워 두면 DB 없이 인메모리로 돈다**(계정/코인 영속화만 꺼진다). 게임은 정상 동작한다.
#
# 로컬 개발(make dev)에서는 localhost 를 가리킨다. 배포 스택에서는 compose 가
# db 서비스를 가리키는 URL 을 직접 넣으므로 여기 값은 쓰이지 않는다.
# 드라이버(+asyncpg)를 안 붙여도 서버가 알아서 붙인다. ?sslmode=require 도 알아서 처리한다.
# DATABASE_URL=postgresql+asyncpg://bulletbrak:bulletbrak@localhost:5432/bulletbrak

# 기동 시 alembic upgrade head 를 자동 실행할지. 인스턴스가 1대라는 전제다.
# 여러 대로 늘리면 false 로 끄고 배포 파이프라인에서 한 번만 돌릴 것.
DB_AUTO_MIGRATE=true

# 커넥션 풀. 게임 루프는 DB 를 안 쓰므로 크게 잡을 이유가 없다.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# 발행되는 SQL 을 전부 로그로 보고 싶을 때만 true
DB_ECHO=false

# 계정 최초 생성 시 localStorage 잔액을 물려받을 수 있는 상한.
# 클라이언트가 보내는 값이라 위조 가능하다 — 기존 플레이어 이관용 유예 장치다.
# 이관이 끝나면 0 으로 내려서 창구를 닫는다.
ACCOUNT_SEED_COINS_MAX=100000
